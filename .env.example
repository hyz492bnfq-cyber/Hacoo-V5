# Obligatoire pour le bot Telegram et le tableau de bord
BOT_TOKEN=
ADMIN_ID=
CHANNEL_ID=
DASHBOARD_PASSWORD=
PORT=3000
TZ=Europe/Paris
# DATA_FILE=/chemin/vers/stockage-persistant/data.json

# Fournisseurs IA (au moins un si tu veux les revues autonomes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b
OPENROUTER_HTTP_REFERER=
V6_AI_PROVIDER=gemini

# Gouvernance V6
V6_AUTONOMY_ENABLED=true
V6_AUTONOMY_INTERVAL_MINUTES=360
V6_AUTONOMY_MAX_RUNS_PER_DAY=4
V6_AUTONOMY_GENERATE_CANDIDATES=false
V6_SELF_DEVELOPMENT_ENABLED=true
V6_DAILY_REPORT_ENABLED=true
V6_DAILY_REPORT_HOUR=9

# Multi-canal : préparé mais désactivé par défaut. JSON : [{"id":"-100123","name":"Canal principal","enabled":true}]
V6_MULTICHANNEL_ENABLED=false
V6_CHANNELS_JSON=

# Déploiement protégé FadeHost via push GitHub (FadeHost doit suivre la même branche)
# Laisse désactivé jusqu’à la configuration et aux tests sur un dépôt de staging.
V6_AUTO_DEPLOY_ENABLED=false
V6_GITHUB_TOKEN=
V6_GITHUB_OWNER=
V6_GITHUB_REPO=
V6_GITHUB_BRANCH=staging
V6_DEPLOY_ADAPTER=github-fadehost

# Supervision et réparations automatiques sans modification de code métier
V6_SUPERVISOR_ENABLED=true
# Déploiement explicite depuis le chat : fichiers ordinaires du projet, tests et santé HTTPS obligatoires
V6_AUTONOMOUS_DEPLOY_SAFE=false
# V6_AUTONOMOUS_DEPLOY_ALLOWLIST est obsolète : les fichiers ordinaires ne sont plus limités par allowlist.

# Santé runtime obligatoire pour le déploiement autonome
V6_DEPLOY_HEALTH_URL=
V6_DEPLOY_HEALTH_TIMEOUT_MS=4000
V6_DEPLOY_HEALTH_ATTEMPTS=6
V6_DEPLOY_HEALTH_INTERVAL_MS=5000

# Autonomie ingénierie persistante (génération de candidats + déploiement protégé)
V6_AUTONOMOUS_ENGINEERING_ENABLED=false
V6_DEPLOY_REQUIRE_RUNTIME_HEALTH=true
# Pour activer « Déploie » : configure les deux flags à true, les identifiants GitHub et une vraie URL HTTPS de santé.
# Les secrets, données persistantes et fichiers contrôlant le déploiement restent protégés. Commence sur staging.

# Auto-développement : sept modules non critiques allowlistés avec tests ciblés, moins de 10 Ko.
# Si vide, le modèle choisit une cible autorisée. Une cible explicite doit être dans l'allowlist interne.
V6_AUTONOMOUS_ENGINEERING_TARGET=

# Boucle d'auto-développement : tests ciblés, réparation bornée et PR en brouillon (aucune fusion automatique).
V6_ENGINEERING_MAX_ATTEMPTS=2
V6_ENGINEERING_TEST_TIMEOUT_MS=30000
V6_AUTONOMOUS_PR_ENABLED=false
V6_GITHUB_PR_BASE_BRANCH=main
